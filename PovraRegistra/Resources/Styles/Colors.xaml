<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores principais da Papoi Skins -->
    <Color x:Key="Primary">#EF3038</Color>
    <Color x:Key="PrimaryDark">#B91C1C</Color>
    <Color x:Key="PrimaryLight">#FF5A60</Color>

    <!-- Fundo gamer -->
    <Color x:Key="AppBackground">#101010</Color>
    <Color x:Key="CardBackground">#1C1C1F</Color>
    <Color x:Key="InputBackground">#27272A</Color>

    <!-- Textos -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B8B8C0</Color>

    <!-- Estados -->
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="BorderColor">#38383D</Color>

    <!-- Cores padrão do MAUI -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#E5E5E5</Color>
    <Color x:Key="Gray300">#D4D4D8</Color>
    <Color x:Key="Gray400">#A1A1AA</Color>
    <Color x:Key="Gray500">#71717A</Color>
    <Color x:Key="Gray600">#52525B</Color>
    <Color x:Key="Gray900">#18181B</Color>

</ResourceDictionary>
