<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PovraRegistra.Views.PrincipalView"
    x:Name="PaginaPrincipal"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="#101010">

    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="#101010">

        <!-- CABEÇALHO: LOGO À ESQUERDA E USUÁRIO À DIREITA -->
        <Grid Grid.Row="0"
              Padding="16,8"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              BackgroundColor="#191919">

            <Image
                Grid.Column="0"
                Source="papoi_logo.png"
                WidthRequest="125"
                HeightRequest="100"
                Aspect="AspectFit"
                VerticalOptions="Center"
                HorizontalOptions="Start"/>

            <Grid Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="4"
                    VerticalOptions="Center"
                    HorizontalOptions="End">

                    <Label
                        Text="{Binding Nome}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"/>

                    <Label
                        Text="{Binding Tipo}"
                        FontSize="12"
                        TextColor="#B8B8C0"
                        HorizontalTextAlignment="End"/>

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="↪"
                    Clicked="SairClicked"
                    FontSize="25"
                    WidthRequest="46"
                    HeightRequest="46"
                    Padding="0"
                    BackgroundColor="#29292D"
                    TextColor="#EF3038"
                    BorderColor="#EF3038"
                    BorderWidth="1"
                    CornerRadius="23"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Sair da conta"/>

            </Grid>
        </Grid>

        <!-- CATÁLOGO -->
        <Grid Grid.Row="1"
              Padding="12,10,12,4"
              RowDefinitions="Auto,*">

            <VerticalStackLayout Grid.Row="0" Spacing="8">

                <Button
                    x:Name="BotaoNova"
                    Text="+ CADASTRAR NOVA SKIN"
                    Clicked="NovaSkinClicked"
                    BackgroundColor="#EF3038"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="9"
                    HeightRequest="42"
                    IsVisible="False"/>

                <Button
                    Text="ATUALIZAR CATÁLOGO"
                    Clicked="AtualizarClicked"
                    BackgroundColor="#252528"
                    TextColor="White"
                    BorderColor="#38383D"
                    BorderWidth="1"
                    CornerRadius="9"
                    HeightRequest="38"/>

                <Label
                    Text="CATÁLOGO DE SKINS"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="0,3,0,0"/>

                <BoxView
                    HeightRequest="1"
                    Color="#38383D"/>

            </VerticalStackLayout>

            <CollectionView
                x:Name="ListaSkins"
                Grid.Row="1"
                SelectionMode="None"
                Margin="0,8,0,0"
                ItemsLayout="HorizontalList"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nenhuma skin cadastrada."
                            FontSize="15"
                            TextColor="#A1A1AA"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="As skins aparecerão aqui."
                            FontSize="12"
                            TextColor="#71717A"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            WidthRequest="190"
                            HeightRequest="245"
                            BackgroundColor="#1C1C1F"
                            Stroke="#38383D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="9"
                            Margin="0,0,10,8">

                            <VerticalStackLayout Spacing="5">

                                <Border
                                    BackgroundColor="#141416"
                                    Stroke="#303035"
                                    StrokeThickness="1"
                                    HeightRequest="95"
                                    Padding="4"
                                    StrokeShape="RoundRectangle 8">

                                    <Image
                                        Source="{Binding ImagemUrl}"
                                        Aspect="AspectFit"/>

                                </Border>

                                <Label
                                    Text="{Binding Nome}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation"/>

                                <Label
                                    Text="{Binding Arma}"
                                    FontSize="12"
                                    TextColor="#EF646A"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation"/>

                                <Label
                                    Text="{Binding Descricao}"
                                    FontSize="11"
                                    TextColor="#C4C4CC"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation"/>

                                <Label
                                    Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#EF3038"
                                    MaxLines="1"/>

                                <Button
                                    Text="SELECIONAR"
                                    Clicked="SelecionarClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={x:Reference PaginaPrincipal}, Path=ClienteLogado}"
                                    FontSize="11"
                                    Padding="3"
                                    BackgroundColor="#EF3038"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="7"
                                    HeightRequest="32"/>

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="5"
                                    IsVisible="{Binding Source={x:Reference PaginaPrincipal}, Path=AdministradorLogado}">

                                    <Button
                                        Grid.Column="0"
                                        Text="EDITAR"
                                        Clicked="EditarClicked"
                                        CommandParameter="{Binding .}"
                                        FontSize="10"
                                        Padding="2"
                                        BackgroundColor="#29292D"
                                        TextColor="White"
                                        BorderColor="#EF3038"
                                        BorderWidth="1"
                                        CornerRadius="7"
                                        HeightRequest="31"/>

                                    <Button
                                        Grid.Column="1"
                                        Text="EXCLUIR"
                                        Clicked="ExcluirClicked"
                                        CommandParameter="{Binding .}"
                                        FontSize="10"
                                        Padding="2"
                                        BackgroundColor="#29292D"
                                        TextColor="#FF6B70"
                                        BorderColor="#5B2528"
                                        BorderWidth="1"
                                        CornerRadius="7"
                                        HeightRequest="31"/>

                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- RODAPÉ -->
        <Grid Grid.Row="2"
              Padding="10,7"
              BackgroundColor="#191919">

            <Button
                Text="HISTÓRICO"
                Clicked="HistoricoClicked"
                BackgroundColor="#29292D"
                TextColor="White"
                BorderColor="#38383D"
                BorderWidth="1"
                CornerRadius="9"
                HeightRequest="40"/>

        </Grid>

    </Grid>
</ContentPage>
